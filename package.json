{
  "name": "myartverse",
  "version": "0.0.5",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -- turbo dev --filter=web-client --no-daemon",
    "dev:desktop": "cd ./apps/desktop && tauri dev",
    "build": "turbo build --filter=web",
    "build:all": "turbo build --concurrency 2",
    "format": "biome format",
    "format:write": "biome format --write",
    "lint": "biome check",
    "lint:write": "biome check . --apply",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "knip": "^5.16.0",
    "turbo": "^2.9.16"
  },
  "dependencies": {
    "next": "15.5.19",
    "swiper": "12.2.0"
  }
}
