# Web client — Vercel → Project → Environment Variables

# Server-side API URL (runtime; used by server actions, route handlers, SSR)
API_URL=https://api.myartverse.app

# Client-side API URL (required at build time for browser OAuth links, etc.)
NEXT_PUBLIC_API_URL=https://api.myartverse.app
NEXT_PUBLIC_SITE_URL=https://dev.myartverse.app
NEXT_PUBLIC_IMAGE_HOSTNAME=dkiv1t9e1oqv5.cloudfront.net

# Analytics (optional)
UMAMI_ID=
MS_CLARITY_ID=

# PayPal (optional)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
