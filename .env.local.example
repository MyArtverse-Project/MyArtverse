# Web client — set in Vercel → Project → Environment Variables
NEXT_PUBLIC_BACKEND_URL="https://your-api.example.com"
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
# Comma-separated image CDN hostnames (no protocol)
NEXT_PUBLIC_IMAGE_HOSTNAME="your-bucket.example.com"

# Analytics
UMAMI_ID=
MS_CLARITY_ID=

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
